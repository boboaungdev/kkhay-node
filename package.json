{
  "name": "kkhay",
  "version": "1.0.4",
  "type": "module",
  "description": "Official Node.js & TypeScript SDK for K Khay Non-Custodial Crypto Payment Gateway (190+ Networks, 500+ Currencies).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test test/sdk.test.js test/cjs.test.cjs",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "kkhay",
    "crypto",
    "cryptocurrency",
    "payments",
    "payment-gateway",
    "gateway",
    "crypto-gateway",
    "crypto-payments",
    "non-custodial",
    "direct-to-wallet",
    "multi-chain",
    "web3",
    "web3-payments",
    "invoice",
    "checkout",
    "webhook",
    "ipn",
    "bitcoin",
    "solana",
    "ton",
    "tron",
    "ethereum",
    "bsc",
    "polygon",
    "base",
    "arbitrum",
    "usdt",
    "usdc",
    "bnb",
    "sdk",
    "typescript"
  ],
  "author": "K Khay",
  "license": "MIT",
  "homepage": "https://kkhay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boboaungdev/kkhay-node.git"
  },
  "bugs": {
    "url": "https://github.com/boboaungdev/kkhay-node/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
